#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h (gitignored) and fill in real values.
// Rotated only by reflashing — there is no runtime provisioning path.

#define BACKEND_BASE_URL "https://your-backend-domain.example.com"

// Sent on every request as a header literally named `auth`, not `Authorization`.
#define API_TOKEN "replace-with-real-device-api-token"

// Every network here is compiled in and rotated only by reflashing, same
// as BACKEND_BASE_URL/API_TOKEN above -- this is a scan-then-match list
// (see wifi_scan_and_select() in adhi-firmware.cpp), not a runtime
// provisioning UI. List as many as needed; each sync wake scans once and
// connects to whichever configured network has the strongest signal among
// the ones actually visible, rather than trying them one at a time (which
// would multiply worst-case wake time against the time_awake_ms
// battery-life budget). Must have at least one entry.
struct wifi_known_network_t {
    const char *ssid;
    const char *password;
};
static const wifi_known_network_t WIFI_NETWORKS[] = {
    {"replace-with-real-wifi-ssid", "replace-with-real-wifi-password"},
};
#define WIFI_NETWORKS_COUNT (sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]))

#endif

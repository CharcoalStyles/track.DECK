#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h (gitignored) and fill in real values.
// Rotated only by reflashing — there is no runtime provisioning path.

#define BACKEND_BASE_URL "https://your-backend-domain.example.com"

// Sent on every request as a header literally named `auth`, not `Authorization`.
#define API_TOKEN "replace-with-real-device-api-token"

#define WIFI_SSID "replace-with-real-wifi-ssid"
#define WIFI_PASSWORD "replace-with-real-wifi-password"

#endif
